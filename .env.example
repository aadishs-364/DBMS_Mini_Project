# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# PostgreSQL connection string. pgvector and pgcrypto must be available.
# Local development database started with "npm run db:local":
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Hosted PostgreSQL (Neon / Supabase) looks like this instead:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Connections in the pool. Keep 1 for the local database (it serves one
# connection at a time); remove the line or use 5 for hosted PostgreSQL.
DATABASE_POOL_MAX=1

# Random string of at least 32 characters, used to sign the login cookie.
SESSION_SECRET=

# Cosine similarity at or above which a new complaint is merged as a duplicate.
DEDUP_THRESHOLD=0.70
